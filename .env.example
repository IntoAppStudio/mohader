# -----------------------------------------------------------------------------
# Mohader — environment variables template
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تضع أي قيمة حقيقية هنا،
# ولا ترفع ملف .env نفسه إلى Git (هو مستثنى بالفعل في .gitignore).
#
# القسمان أدناه مفصولان عمدًا:
#   PUBLIC  = تُبنى داخل حزمة المتصفح (بادئة VITE_). آمنة، ليست أسرارًا حقيقية.
#   SERVER-ONLY = تُقرأ فقط من كود سيرفر (*.server.ts / server functions).
#                 يجب ألا تصل هذه القيم أبدًا إلى المتصفح أو الـGit.
# -----------------------------------------------------------------------------

# ============================= PUBLIC (client) ==============================
# من: Supabase Dashboard -> Project Settings -> API. القيمة "publishable" فقط
# (وليس service role) — هذه القيم من تصميمها آمنة للظهور في كود العميل، محمية
# بسياسات RLS على مستوى قاعدة البيانات.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ============================ SERVER-ONLY ====================================

# --- Supabase (نفس القيم أعلاه، لكن لقراءة السيرفر — انظر public.functions.ts) --
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# 🔒 SECRET — يتجاوز RLS بالكامل. يُستخدم فقط في
# src/integrations/supabase/client.server.ts (كود سيرفر فقط، لا يصل أبدًا إلى
# المتصفح). اضبطه كسر بيئة (secret) في مزوّد الاستضافة، ولا تضعه أبدًا في .env
# مرفوع أو في أي كود عميل.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (src/lib/ai.server.ts) -------------------------------------
# يتحدث بروتوكول OpenAI "chat completions". أي مزود يقبل هذا الشكل يعمل بدون
# أي تعديل كود:
#   - OpenRouter (يدعم أيضًا إرسال ملف PDF كامل كإدخال، تمامًا كما في aiJsonWithFile):
#       AI_GATEWAY_URL=https://openrouter.ai/api/v1/chat/completions
#       AI_MODEL=google/gemini-3.7-flash
#   - OpenAI مباشرة:
#       AI_GATEWAY_URL=https://api.openai.com/v1/chat/completions
#       AI_MODEL=gpt-4o-mini   (يحتاج يدعم الرؤية لميزات تحليل الصور/PDF)
#   - أي بوابة أخرى متوافقة مع OpenAI (Groq, Together, self-hosted, ...)
AI_GATEWAY_URL=
# 🔒 SECRET
AI_API_KEY=
AI_MODEL=

# --- Cron (src/integrations/supabase/cron-auth.ts) --------------------------
# يحمي المسار المجدول الذي يعيد فحص الـjobs العالقة (انظر التقرير: retryStuckJobs).
# 🔒 SECRET × 2 (القيمة الثانية اختيارية، لتدوير السر بدون قطع طلبات قيد التنفيذ)
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# --- TTS (src/lib/tts.server.ts, AI-generated lesson narration) -----------
# نفس فلسفة AI_GATEWAY_URL: أي endpoint يتحدث شكل OpenAI "audio/speech" يعمل.
#   TTS_GATEWAY_URL=https://api.openai.com/v1/audio/speech
#   TTS_VOICE=alloy
TTS_GATEWAY_URL=
# 🔒 SECRET
TTS_API_KEY=
TTS_VOICE=

# --- Paddle (src/lib/paddle-webhook.server.ts, src/lib/checkout.server.ts) -
# من: Paddle Dashboard -> Developer Tools -> Notifications (لإنشاء الـwebhook
# destination والحصول على السر)، و Developer Tools -> Authentication (API key
# لإنشاء عمليات الدفع)، و Catalog -> Prices (لمعرّفات الأسعار).
# 🔒 SECRET — يُستخدم للتحقق من توقيع الطلب (HMAC)، وليس مفتاح API عادي.
PADDLE_WEBHOOK_SECRET=
# 🔒 SECRET — يُستخدم لإنشاء عمليات الدفع (transactions) عبر Paddle API.
PADDLE_API_KEY=
# اختياري؛ الافتراضي https://api.paddle.com. استخدم sandbox-api.paddle.com للاختبار.
PADDLE_API_URL=
PADDLE_PRICE_STUDENT=
PADDLE_PRICE_PRO=

# ---------------------------------------------------------------------------
# Queue, credits, cache, embeddings, TTS (added with migration 20261030090000)
# ---------------------------------------------------------------------------
# Public base URL of the deployed app; lets the app "kick" the queue worker right after enqueue.
APP_BASE_URL=
# Parallel AI calls per build job (3-5 recommended).
AI_CONCURRENCY=4
# Hard cap on lessons per course build (extra sections are reported, never silently dropped).
MAX_LESSONS=60
# Credits charged per 1,000 real tokens (see src/lib/creditsLedger.server.ts).
CREDITS_PER_1K_TOKENS=0.5
# Optional semantic verification (OpenAI-compatible /embeddings endpoint).
EMBEDDINGS_GATEWAY_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Server TTS: mp3 is required for long lessons (parts are joined). TTS_MODEL defaults to tts-1.
TTS_FORMAT=mp3
TTS_MODEL=tts-1

# ---------------------------------------------------------------------------
# Local payments (Saudi Arabia first). Moyasar covers mada, STC Pay, Apple Pay, cards.
# ---------------------------------------------------------------------------
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
